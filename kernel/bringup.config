CONFIG_LOCALVERSION="-gts3l1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_NCM=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_ACM=y
CONFIG_USB_U_SERIAL=y
CONFIG_CONFIGFS_FS=y
CONFIG_RD_GZIP=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_I2C_GPIO=y
CONFIG_BATTERY_SM5705=y
CONFIG_CHARGER_SM5705=y
CONFIG_QCOM_SPMI_VADC=y
CONFIG_KEYBOARD_TM2_TOUCHKEY=m
# CONFIG_QCOM_SNS_REG is not set
CONFIG_NLS_UTF8=m
# SoC temperature sensors (TSENS); a module so a modprobe.d blacklist can turn it off
CONFIG_QCOM_TSENS=m
# Speaker amplifiers (RT5508); a module so a modprobe.d blacklist can turn them off
CONFIG_SND_SOC_RT5508=m
# Snapdragon Sensor Core: Sensor Manager service and its accelerometer (auto-rotation)
CONFIG_IIO_QCOM_SMGR=m
CONFIG_IIO_QCOM_SMGR_ACCEL=m
# Sensor Manager gyroscope, magnetometer and ambient light sensor
CONFIG_IIO_QCOM_SMGR_GYRO=m
CONFIG_IIO_QCOM_SMGR_MAG=m
CONFIG_IIO_QCOM_SMGR_LIGHT=m
# Vibration motor: the GCC GP1 clock as its PWM
CONFIG_PWM_CLK=y
# Grip (SAR) sensors
CONFIG_SX9310=m
# S Pen (Wacom W9019, Samsung firmware protocol: patch 0035)
CONFIG_TOUCHSCREEN_WACOM_I2C=m
# Rear camera: Sony IMX258 and its DW9807 actuator through the MSM8996 CAMSS
CONFIG_VIDEO_IMX258=m
CONFIG_VIDEO_S5K5E3=m
CONFIG_VIDEO_DW9807_VCM=m
# Unattended operation: a kernel oops, a task stuck for two minutes or a
# CPU stuck in the kernel panics, and panic=30 reboots (package 62: an
# oops in the camera driver left the tablet pinging but unreachable).
CONFIG_PANIC_ON_OOPS=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y

# Expose watchdog state for server health monitoring.
CONFIG_WATCHDOG_SYSFS=y

# Firmware PSCI standalone power collapse; full-server RAM validation required.
CONFIG_ARM_PSCI_CPUIDLE=y
# Calibrated AP thermistor; complements battery/charger and TSENS sensors.
CONFIG_GTS3L_SKIN_THERMAL=m

# Board thermistors on the PMIC ADC as thermal zones (package 67)
CONFIG_GENERIC_ADC_THERMAL=y

# The USB-C controller: a hub that charges takes over VBUS while the tablet hosts (package 71)
CONFIG_TYPEC_S2MM005=m
CONFIG_LEDS_CLASS_FLASH=y
