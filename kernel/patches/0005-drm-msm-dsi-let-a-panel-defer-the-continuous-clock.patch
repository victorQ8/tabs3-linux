Subject: [PATCH] drm/msm/dsi: let a panel defer the continuous clock

The Anapass ANA38401 DDI of the Samsung AMS968HH01 panel must leave reset
with the clock lane in LP-11. dsi_ctrl_enable() starts the continuous HS
clock while the host powers up, before the panel's prepare() releases
reset, and the DDI then ignores the early register writes (measured twice
on SM-T825). Samsung's downstream mdss_dsi forces the HS clock only after
reset and TCON_RDY.

Add MIPI_DSI_CLOCK_DEFER_CONTINUOUS. When a device sets it, the msm host
keeps the clock lane in LP-11 at power-on and starts the continuous clock
with the first transfer, on both links of a bonded pair. A quick DPMS
cycle can leave the host powered through its runtime autosuspend delay, so
bridge pre-enable also defers the clock on hosts that are already powered.

This replaces the SM-T825 machine-compatible checks and the "panel LP11"
logging of the bring-up patches (formerly 0028-0030). Devices without the
flag keep the existing clock order.

--- a/include/drm/drm_mipi_dsi.h
+++ b/include/drm/drm_mipi_dsi.h
@@ -138,6 +138,9 @@
 #define MIPI_DSI_MODE_LPM		BIT(11)
 /* transmit data ending at the same time for all lanes within one hsync */
 #define MIPI_DSI_HS_PKT_END_ALIGNED	BIT(12)
+/* keep the clock lane in LP-11 after power-on, start the continuous clock
+ * with the first transfer (the device leaves reset with the clock idle) */
+#define MIPI_DSI_CLOCK_DEFER_CONTINUOUS	BIT(13)
 
 enum mipi_dsi_pixel_format {
 	MIPI_DSI_FMT_RGB888,
--- a/drivers/gpu/drm/msm/dsi/dsi.h
+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -63,6 +63,8 @@
 
 /* dsi host */
 struct msm_dsi_host;
+void msm_dsi_host_defer_clock(struct mipi_dsi_host *host);
+void msm_dsi_host_start_deferred_clock(struct mipi_dsi_host *host);
 int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 					const struct mipi_dsi_msg *msg);
 void msm_dsi_host_xfer_restore(struct mipi_dsi_host *host,
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -185,6 +185,7 @@
 
 	bool registered;
 	bool power_on;
+	bool continuous_clock_pending;
 	bool enabled;
 	int irq;
 };
@@ -878,11 +879,20 @@
 	if (!(flags & MIPI_DSI_CLOCK_NON_CONTINUOUS)) {
 		lane_ctrl = dsi_read(msm_host, REG_DSI_LANE_CTRL);
 
-		if (msm_dsi_phy_set_continuous_clock(phy, true))
-			lane_ctrl &= ~DSI_LANE_CTRL_HS_REQ_SEL_PHY;
+		/* The first transfer starts it: msm_dsi_host_start_deferred_clock() */
+		msm_host->continuous_clock_pending =
+			flags & MIPI_DSI_CLOCK_DEFER_CONTINUOUS;
+		if (msm_host->continuous_clock_pending) {
+			msm_dsi_phy_set_continuous_clock(phy, false);
+			dsi_write(msm_host, REG_DSI_LANE_CTRL,
+				  lane_ctrl & ~DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+		} else {
+			if (msm_dsi_phy_set_continuous_clock(phy, true))
+				lane_ctrl &= ~DSI_LANE_CTRL_HS_REQ_SEL_PHY;
 
-		dsi_write(msm_host, REG_DSI_LANE_CTRL,
-			lane_ctrl | DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+			dsi_write(msm_host, REG_DSI_LANE_CTRL,
+				lane_ctrl | DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+		}
 	}
 
 	data |= DSI_CTRL_ENABLE;
@@ -2100,6 +2110,45 @@
 	}
 }
 
+/*
+ * MIPI_DSI_CLOCK_DEFER_CONTINUOUS: a quick DPMS cycle can leave the host
+ * powered through its runtime autosuspend delay, so dsi_ctrl_enable() does
+ * not run again. Stop the clock again before every panel prepare.
+ */
+void msm_dsi_host_defer_clock(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	struct msm_dsi *msm_dsi = platform_get_drvdata(msm_host->pdev);
+	u32 lane_ctrl;
+
+	if (!(msm_host->mode_flags & MIPI_DSI_CLOCK_DEFER_CONTINUOUS) ||
+	    (msm_host->mode_flags & MIPI_DSI_CLOCK_NON_CONTINUOUS) ||
+	    msm_host->continuous_clock_pending)
+		return;
+	msm_dsi_phy_set_continuous_clock(msm_dsi->phy, false);
+	lane_ctrl = dsi_read(msm_host, REG_DSI_LANE_CTRL);
+	dsi_write(msm_host, REG_DSI_LANE_CTRL,
+		  lane_ctrl & ~DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+	msm_host->continuous_clock_pending = true;
+}
+
+/* Called with the host powered, before the first transfer after prepare. */
+void msm_dsi_host_start_deferred_clock(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
+	struct msm_dsi *msm_dsi = platform_get_drvdata(msm_host->pdev);
+	u32 lane_ctrl;
+
+	if (!msm_host->continuous_clock_pending)
+		return;
+	lane_ctrl = dsi_read(msm_host, REG_DSI_LANE_CTRL);
+	if (msm_dsi_phy_set_continuous_clock(msm_dsi->phy, true))
+		lane_ctrl &= ~DSI_LANE_CTRL_HS_REQ_SEL_PHY;
+	dsi_write(msm_host, REG_DSI_LANE_CTRL,
+		  lane_ctrl | DSI_LANE_CTRL_CLKLN_HS_FORCE_REQUEST);
+	msm_host->continuous_clock_pending = false;
+}
+
 int msm_dsi_host_xfer_prepare(struct mipi_dsi_host *host,
 				const struct mipi_dsi_msg *msg)
 {
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -314,6 +314,11 @@
 		goto put_pm;
 	}
 
+	/* The panel prepare that follows may need the clock lane in LP-11 */
+	msm_dsi_host_defer_clock(host);
+	if (is_bonded_dsi && msm_dsi1)
+		msm_dsi_host_defer_clock(msm_dsi1->host);
+
 	ret = msm_dsi_host_enable(host);
 	if (ret) {
 		pr_err("%s: enable host %d failed, %d\n", __func__, id, ret);
@@ -526,6 +531,15 @@
 		goto restore_host0;
 	}
 
+	/* Start both links' deferred clocks before the first DSI0-only packet */
+	if (IS_BONDED_DSI()) {
+		struct msm_dsi *other = dsi_mgr_get_dsi(id ^ 1);
+
+		if (other)
+			msm_dsi_host_start_deferred_clock(other->host);
+	}
+	msm_dsi_host_start_deferred_clock(host);
+
 	ret = is_read ? msm_dsi_host_cmd_rx(host, msg) :
 			msm_dsi_host_cmd_tx(host, msg);
 
