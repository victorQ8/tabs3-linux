+static int rt5508_volume_get(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct rt5508_priv *rt5508 = snd_soc_component_get_drvdata(component);
+
+	ucontrol->value.integer.value[0] = rt5508->volume;
+	return 0;
+}
+
+/* Kept in memory and applied at power-up: writes need the chip powered. */
+static int rt5508_volume_put(struct snd_kcontrol *kcontrol,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct rt5508_priv *rt5508 = snd_soc_component_get_drvdata(component);
+	unsigned int volume = ucontrol->value.integer.value[0];
+	int ret;
+
+	if (volume > RT5508_VOLUME_MAX)
+		return -EINVAL;
+	if (volume == rt5508->volume)
+		return 0;
+	rt5508->volume = volume;
+	if (rt5508->powered) {
+		ret = regmap_write(rt5508->regmap, RT5508_REG_VOLUME,
+				   rt5508_volume_reg(volume));
+		if (ret)
+			return ret;
+	}
+	return 1;
+}
