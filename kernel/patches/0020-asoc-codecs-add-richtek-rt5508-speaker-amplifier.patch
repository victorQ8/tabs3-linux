+static int rt5508_chip_init(struct rt5508_priv *rt5508)
+{
+	unsigned int val;
+	int ret;
+
+	ret = rt5508_chip_power(rt5508, true);
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(rt5508->regmap, RT5508_REG_SWRESET, BIT(7), BIT(7));
+	if (ret)
+		return ret;
+	msleep(30);
+	ret = rt5508_chip_power(rt5508, true);
+	if (ret)
+		return ret;
+
+	ret = regmap_read(rt5508->regmap, RT5508_REG_CHIPREV, &val);
+	if (ret)
+		return ret;
+	if ((val & RT5508_CHIPID_MASK) != RT5508_CHIP_ID)
+		return dev_err_probe(rt5508->dev, -ENODEV, "unknown chip ID %02x\n", val);
+	rt5508->chip_rev = val & RT5508_CHIPREV_MASK;
+	dev_info(rt5508->dev, "RT5508 revision %u\n", rt5508->chip_rev);
+
+	/* Triangle wave and all digital clocks off */
+	ret = regmap_update_bits(rt5508->regmap, RT5508_REG_CHIPEN, RT5508_TRIWAVE_EN, 0);
+	if (!ret)
+		ret = regmap_write(rt5508->regmap, RT5508_REG_CLKEN1, 0x00);
+	if (!ret)
+		ret = regmap_update_bits(rt5508->regmap, RT5508_REG_CLKEN2, 0x03, 0);
+	if (ret)
+		return ret;
+	return rt5508_chip_power(rt5508, false);
+}
+
+static int rt5508_i2c_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct rt5508_priv *rt5508;
+	u32 val;
+	int ret;
+
+	if (!i2c_check_functionality(i2c->adapter, I2C_FUNC_SMBUS_I2C_BLOCK))
+		return -EOPNOTSUPP;
+
+	rt5508 = devm_kzalloc(dev, sizeof(*rt5508), GFP_KERNEL);
+	if (!rt5508)
+		return -ENOMEM;
+	rt5508->dev = dev;
+	rt5508->volume = RT5508_VOLUME_DEFAULT;
+	i2c_set_clientdata(i2c, rt5508);
+
+	rt5508->tdm_mode = device_property_read_bool(dev, "richtek,tdm-mode");
+	rt5508->dac_slot = !device_property_read_u32(dev, "richtek,tdm-dac-slot", &val) && val;
+	rt5508->adc_slot = !device_property_read_u32(dev, "richtek,tdm-adc-slot", &val) && val;
+	rt5508->channel = 1;	/* (left + right) / 2 */
+	if (!device_property_read_u32(dev, "richtek,channel", &val)) {
+		if (val > 2)
+			return dev_err_probe(dev, -EINVAL, "richtek,channel must be 0-2\n");
+		rt5508->channel = val;
+	}
+	/* Stock operating point until hw_params: 48 kHz, 16 bit */
+	rt5508->audsr = RT5508_BCKMODE_32FS | 5;
+	rt5508->audbit = RT5508_AUDBIT_16;
+	rt5508->pll_divider = rt5508->tdm_mode ? 0x00080000 : 0x00100000;
+
+	rt5508->regmap = devm_regmap_init(dev, NULL, i2c, &rt5508_regmap_config);
+	if (IS_ERR(rt5508->regmap))
+		return dev_err_probe(dev, PTR_ERR(rt5508->regmap), "regmap init failed\n");
+
+	ret = rt5508_chip_init(rt5508);
+	if (ret)
+		return dev_err_probe(dev, ret, "chip init failed\n");
+
+	return devm_snd_soc_register_component(dev, &rt5508_component_driver,
+					       &rt5508_dai, 1);
+}
