+static int rt5508_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct rt5508_priv *rt5508 = snd_soc_component_get_drvdata(dai->component);
+	unsigned int val;
+
+	if ((fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) != SND_SOC_DAIFMT_CBC_CFC)
+		return -EINVAL;
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+	case SND_SOC_DAIFMT_DSP_A:
+		val = 0;
+		break;
+	case SND_SOC_DAIFMT_LEFT_J:
+		val = RT5508_AUDFMT_LEFTJ;
+		break;
+	case SND_SOC_DAIFMT_RIGHT_J:
+		val = RT5508_AUDFMT_RIGHTJ;
+		break;
+	case SND_SOC_DAIFMT_DSP_B:
+		val = RT5508_DSPMODE_B;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	rt5508->audfmt = val;
+	return 0;
+}
+
+static int rt5508_hw_params(struct snd_pcm_substream *substream,
+			    struct snd_pcm_hw_params *params, struct snd_soc_dai *dai)
+{
+	struct rt5508_priv *rt5508 = snd_soc_component_get_drvdata(dai->component);
+	unsigned int audsr, audbit, divider;
+
+	switch (params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		audsr = RT5508_BCKMODE_32FS;
+		audbit = RT5508_AUDBIT_16;
+		divider = 0x00100000;
+		break;
+	case SNDRV_PCM_FORMAT_S24_3LE:
+		audsr = RT5508_BCKMODE_48FS;
+		audbit = RT5508_AUDBIT_24;
+		divider = 0x000c0000;
+		break;
+	case SNDRV_PCM_FORMAT_S32_LE:
+		audsr = RT5508_BCKMODE_64FS;
+		audbit = RT5508_AUDBIT_24;
+		divider = 0x00080000;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	switch (params_rate(params)) {
+	case 8000:
+		audsr |= 0;
+		divider *= 6;
+		break;
+	case 11025:
+	case 12000:
+		audsr |= 1;
+		divider *= 4;
+		break;
+	case 16000:
+		audsr |= 2;
+		divider *= 3;
+		break;
+	case 22050:
+	case 24000:
+		audsr |= 3;
+		divider *= 2;
+		break;
+	case 32000:
+		audsr |= 4;
+		divider = divider * 3 / 2;
+		break;
+	case 44100:
+	case 48000:
+		audsr |= 5;
+		break;
+	case 88200:
+	case 96000:
+		audsr |= 6;
+		divider /= 2;
+		break;
+	case 176400:
+	case 192000:
+		audsr |= 7;
+		divider /= 4;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	/* The bit clock carries twice the samples in TDM mode */
+	if (rt5508->tdm_mode)
+		divider /= 2;
+
+	rt5508->audsr = audsr;
+	rt5508->audbit = audbit;
+	rt5508->pll_divider = divider;
+	return 0;
+}
+
+static int rt5508_set_tdm_slot(struct snd_soc_dai *dai, unsigned int tx_mask,
+			       unsigned int rx_mask, int slots, int slot_width)
+{
+	struct rt5508_priv *rt5508 = snd_soc_component_get_drvdata(dai->component);
+
+	/* The slot comes from the device tree; only 4-slot TDM exists. */
+	if (slots && slots != 4)
+		return -EINVAL;
+	rt5508->tdm_mode = slots == 4;
+	return 0;
+}
+
+static int rt5508_mute_stream(struct snd_soc_dai *dai, int mute, int stream)
+{
+	struct rt5508_priv *rt5508 = snd_soc_component_get_drvdata(dai->component);
+
+	if (!rt5508->powered)
+		return 0;
+	return regmap_update_bits(rt5508->regmap, RT5508_REG_CHIPEN, RT5508_SPKMUTE,
+				  mute ? RT5508_SPKMUTE : 0);
+}
