+/* The vendor's amplifier and boost ramp, step for step */
+static int rt5508_boost_event(struct snd_soc_dapm_widget *w,
+			      struct snd_kcontrol *kcontrol, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct rt5508_priv *rt5508 = snd_soc_component_get_drvdata(component);
+	struct regmap *map = rt5508->regmap;
+	unsigned int ovpuvp = rt5508->chip_rev >= RT5508_CHIP_REVG ? 0xe0 : 0xc0;
+	unsigned int event_info;
+	int ret;
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		ret = regmap_read(map, RT5508_REG_BST_MODE, &rt5508->bst_mode);
+		if (!ret)
+			ret = rt5508_write_table(rt5508, rt5508_amp_on,
+						 ARRAY_SIZE(rt5508_amp_on));
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_OVPUVPCTRL, ovpuvp);
+		/* Triangle wave on; protection, mute and power-down bits clear */
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_CHIPEN, RT5508_TRIWAVE_EN);
+		return ret;
+	case SND_SOC_DAPM_POST_PMU:
+		usleep_range(5000, 5500);
+		ret = regmap_write(map, RT5508_REG_CLKEN1, 0xff);
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_BST_MODE, rt5508->bst_mode);
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_ECO_CTRL, 0x64);
+		if (!ret && !regmap_read(map, RT5508_REG_EVENTINFO, &event_info) &&
+		    (event_info & (BIT(7) | BIT(6))) != (BIT(7) | BIT(6)))
+			dev_warn(rt5508->dev, "bit clock or PLL not locked: %02x\n",
+				 event_info);
+		return ret;
+	case SND_SOC_DAPM_PRE_PMD:
+		ret = regmap_write(map, RT5508_REG_ECO_CTRL, 0x24);
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_BST_CONF1, 0xb5);
+		if (!ret)
+			ret = regmap_read(map, RT5508_REG_BST_MODE, &rt5508->bst_mode);
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_BST_MODE, RT5508_BST_MODE_RAMP);
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_CLKEN1, 0xbf);
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_OVPUVPCTRL, 0x00);
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_OCPOTPEN, 0x00);
+		return ret;
+	case SND_SOC_DAPM_POST_PMD:
+		usleep_range(5000, 5500);
+		ret = rt5508_write_table(rt5508, rt5508_amp_off, ARRAY_SIZE(rt5508_amp_off));
+		if (!ret)
+			ret = regmap_write(map, RT5508_REG_BST_MODE, rt5508->bst_mode);
+		return ret;
+	default:
+		return 0;
+	}
+}
