+
 /* struct qmp_phy_cfg - per-PHY initialization config */
 struct qmp_phy_cfg {
 	/* number of PHYs provided by this block */
@@ -277,6 +356,26 @@
 	.regs			= pciephy_regs_layout,
 };
 
+static const struct qmp_phy_cfg msm8996_v3_pciephy_cfg = {
