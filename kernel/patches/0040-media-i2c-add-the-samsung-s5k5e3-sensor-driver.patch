+
+/*
+ * PLL and MIPI setup shared by the modes: 24 MHz / 6 * 224 = 896 MHz,
+ * 896 Mbps per lane, two lanes (0x0114 = 1), 10-bit output.
+ */
+static const struct cci_reg_sequence s5k5e3_mode_common_regs[] = {
+	{ CCI_REG8(0x0305), 0x06 }, { CCI_REG8(0x0306), 0x00 },
+	{ CCI_REG8(0x0307), 0xe0 }, { CCI_REG8(0x3c1f), 0x00 },
+	{ CCI_REG8(0x0820), 0x03 }, { CCI_REG8(0x0821), 0x80 },
+	{ CCI_REG8(0x3c1c), 0x58 }, { CCI_REG8(0x0114), 0x01 },
+	{ CCI_REG8(0x0342), 0x0b }, { CCI_REG8(0x0343), 0x86 },
+	{ CCI_REG8(0x0200), 0x04 }, { CCI_REG8(0x0201), 0x98 },
+	{ CCI_REG8(0x3941), 0x04 }, { CCI_REG8(0x3942), 0xb5 },
+	{ CCI_REG8(0x3924), 0x2f }, { CCI_REG8(0x3925), 0x10 },
+	{ CCI_REG8(0x3c31), 0x54 }, { CCI_REG8(0x3c32), 0x60 },
+	{ CCI_REG8(0x3c08), 0x5d }, { CCI_REG8(0x3c09), 0xc0 },
+	{ CCI_REG8(0x3320), 0x02 }, { CCI_REG8(0x0112), 0x0a },
+	{ CCI_REG8(0x0113), 0x0a },
+};
+
+/* 2576x1932, full field, 30 fps at the default frame length of 2025 lines */
+static const struct cci_reg_sequence s5k5e3_mode_2576x1932_regs[] = {
+	{ CCI_REG8(0x0344), 0x00 }, { CCI_REG8(0x0345), 0x00 },
+	{ CCI_REG8(0x0346), 0x00 }, { CCI_REG8(0x0347), 0x02 },
+	{ CCI_REG8(0x0348), 0x0a }, { CCI_REG8(0x0349), 0x0f },
+	{ CCI_REG8(0x034a), 0x07 }, { CCI_REG8(0x034b), 0x8d },
+	{ CCI_REG8(0x034c), 0x0a }, { CCI_REG8(0x034d), 0x10 },
+	{ CCI_REG8(0x034e), 0x07 }, { CCI_REG8(0x034f), 0x8c },
+	{ CCI_REG8(0x0900), 0x00 }, { CCI_REG8(0x0901), 0x00 },
+	{ CCI_REG8(0x0383), 0x01 }, { CCI_REG8(0x0387), 0x01 },
+};
+
+/* 640x480, 4x4 binning of a 2560x1920 crop, 120 fps at 506 lines */
+static const struct cci_reg_sequence s5k5e3_mode_640x480_regs[] = {
+	{ CCI_REG8(0x0344), 0x00 }, { CCI_REG8(0x0345), 0x08 },
+	{ CCI_REG8(0x0346), 0x00 }, { CCI_REG8(0x0347), 0x08 },
+	{ CCI_REG8(0x0348), 0x0a }, { CCI_REG8(0x0349), 0x07 },
+	{ CCI_REG8(0x034a), 0x07 }, { CCI_REG8(0x034b), 0x87 },
+	{ CCI_REG8(0x034c), 0x02 }, { CCI_REG8(0x034d), 0x80 },
+	{ CCI_REG8(0x034e), 0x01 }, { CCI_REG8(0x034f), 0xe0 },
+	{ CCI_REG8(0x0900), 0x01 }, { CCI_REG8(0x0901), 0x44 },
+	{ CCI_REG8(0x0383), 0x03 }, { CCI_REG8(0x0387), 0x07 },
+};
+
