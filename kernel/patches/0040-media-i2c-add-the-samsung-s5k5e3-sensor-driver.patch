+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5K5E3YX 5 megapixel CMOS image sensor driver
+ *
+ * A 5 megapixel sensor (2576x1932 active in this configuration) with an
+ * SMIA-style register map (16-bit addresses, 8-bit data), streaming 10-bit
+ * raw Bayer over two MIPI CSI-2 lanes at 896 Mbps per lane from a 24 MHz
+ * input clock. The register settings follow the module's vendor
+ * configuration (Samsung SM-T825 front camera); the sensor has no public
+ * datasheet.
+ *
+ * Copyright (C) 2026 tabS3 bring-up
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define S5K5E3_REG_CHIP_ID		CCI_REG16(0x0000)
+#define S5K5E3_CHIP_ID			0x5e30
+
+#define S5K5E3_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define S5K5E3_MODE_STANDBY		0x00
+#define S5K5E3_MODE_STREAMING		0x01
+
+#define S5K5E3_REG_IMAGE_ORIENTATION	CCI_REG8(0x0101)
+#define S5K5E3_REG_GROUP_HOLD		CCI_REG8(0x0104)
+
+#define S5K5E3_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5K5E3_EXPOSURE_MIN		2
+#define S5K5E3_EXPOSURE_STEP		1
+#define S5K5E3_EXPOSURE_DEFAULT		0x200
+/* Lines the exposure must stay below the frame length */
+#define S5K5E3_EXPOSURE_OFFSET		8
+
+/* Analogue gain code is the gain times 32: 0x20 is 1x, 0x200 is 16x */
+#define S5K5E3_REG_ANALOG_GAIN		CCI_REG16(0x0204)
+#define S5K5E3_ANA_GAIN_MIN		32
+#define S5K5E3_ANA_GAIN_MAX		512
+#define S5K5E3_ANA_GAIN_STEP		1
+#define S5K5E3_ANA_GAIN_DEFAULT		32
+
+/* Digital gain code is the gain times 256, one register per Bayer channel */
+#define S5K5E3_REG_DIGITAL_GAIN_GR	CCI_REG16(0x020e)
+#define S5K5E3_REG_DIGITAL_GAIN_R	CCI_REG16(0x0210)
