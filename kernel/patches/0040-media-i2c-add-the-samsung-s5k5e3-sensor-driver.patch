+};
+
+static const char * const s5k5e3_test_pattern_menu[] = {
+	"Disabled",
+	"Solid Colour",
+	"Eight Vertical Colour Bars",
+	"Colour Bars With Fade to Grey",
+	"Pseudorandom Sequence (PN9)",
+};
+
+struct s5k5e3 {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct regmap *regmap;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+	const struct s5k5e3_mode *cur_mode;
+	/* Serialises the format, the controls and streaming */
+	struct mutex mutex;
+	struct clk *clk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[S5K5E3_NUM_SUPPLIES];
+};
+
+static inline struct s5k5e3 *to_s5k5e3(struct v4l2_subdev *_sd)
+{
+	return container_of(_sd, struct s5k5e3, sd);
+}
+
+/* The readout starts on a GR line; mirroring and flipping move the origin */
+static u32 s5k5e3_get_format_code(struct s5k5e3 *s5k5e3)
+{
+	static const u32 codes[2][2] = {
+		{ MEDIA_BUS_FMT_SGRBG10_1X10, MEDIA_BUS_FMT_SRGGB10_1X10 },
+		{ MEDIA_BUS_FMT_SBGGR10_1X10, MEDIA_BUS_FMT_SGBRG10_1X10 },
+	};
+
+	return codes[s5k5e3->vflip->val][s5k5e3->hflip->val];
+}
+
+static int s5k5e3_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k5e3 *s5k5e3 = container_of(ctrl->handler, struct s5k5e3,
+					     ctrl_handler);
+	int ret = 0;
+
+	/*
+	 * The exposure may not exceed the frame length minus the offset,
+	 * so its range follows the vertical blanking.
+	 */
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int exposure_max = s5k5e3->cur_mode->height + ctrl->val -
+				   S5K5E3_EXPOSURE_OFFSET;
+		int exposure_def = min(exposure_max, S5K5E3_EXPOSURE_DEFAULT);
+
+		__v4l2_ctrl_modify_range(s5k5e3->exposure,
+					 s5k5e3->exposure->minimum,
+					 exposure_max, s5k5e3->exposure->step,
+					 exposure_def);
+	}
+
+	/* Only apply to the hardware while it is powered */
+	if (pm_runtime_get_if_in_use(s5k5e3->dev) == 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5k5e3->regmap, S5K5E3_REG_ANALOG_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5k5e3->regmap, S5K5E3_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		cci_write(s5k5e3->regmap, S5K5E3_REG_DIGITAL_GAIN_GR,
+			  ctrl->val, &ret);
+		cci_write(s5k5e3->regmap, S5K5E3_REG_DIGITAL_GAIN_R,
+			  ctrl->val, &ret);
+		cci_write(s5k5e3->regmap, S5K5E3_REG_DIGITAL_GAIN_B,
+			  ctrl->val, &ret);
+		cci_write(s5k5e3->regmap, S5K5E3_REG_DIGITAL_GAIN_GB,
+			  ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5k5e3->regmap, S5K5E3_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5k5e3->regmap, S5K5E3_REG_FRAME_LENGTH,
+				s5k5e3->cur_mode->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(s5k5e3->regmap, S5K5E3_REG_IMAGE_ORIENTATION,
+				s5k5e3->hflip->val | s5k5e3->vflip->val << 1,
+				NULL);
+		break;
+	default:
+		dev_dbg(s5k5e3->dev, "unhandled control 0x%x\n", ctrl->id);
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(s5k5e3->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k5e3_ctrl_ops = {
+	.s_ctrl = s5k5e3_set_ctrl,
+};
+
+static int s5k5e3_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5k5e3_get_format_code(s5k5e3);
+
+	return 0;
+}
+
+static int s5k5e3_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+
+	if (fse->index >= ARRAY_SIZE(supported_modes))
+		return -EINVAL;
+
+	if (fse->code != s5k5e3_get_format_code(s5k5e3))
+		return -EINVAL;
+
+	fse->min_width = supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static void s5k5e3_update_pad_format(struct s5k5e3 *s5k5e3,
+				     const struct s5k5e3_mode *mode,
+				     struct v4l2_mbus_framefmt *format)
+{
+	format->width = mode->width;
+	format->height = mode->height;
+	format->code = s5k5e3_get_format_code(s5k5e3);
+	format->field = V4L2_FIELD_NONE;
+	format->colorspace = V4L2_COLORSPACE_RAW;
+	format->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	format->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	format->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k5e3_get_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+
+	mutex_lock(&s5k5e3->mutex);
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		fmt->format = *v4l2_subdev_state_get_format(sd_state, fmt->pad);
+	else
+		s5k5e3_update_pad_format(s5k5e3, s5k5e3->cur_mode,
+					 &fmt->format);
+	mutex_unlock(&s5k5e3->mutex);
+
+	return 0;
+}
+
+static int s5k5e3_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	const struct s5k5e3_mode *mode;
+	s32 vblank_def;
+	s64 h_blank;
+
+	mutex_lock(&s5k5e3->mutex);
+
+	mode = v4l2_find_nearest_size(supported_modes,
+				      ARRAY_SIZE(supported_modes), width, height,
+				      fmt->format.width, fmt->format.height);
+	s5k5e3_update_pad_format(s5k5e3, mode, &fmt->format);
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY) {
+		*v4l2_subdev_state_get_format(sd_state, fmt->pad) = fmt->format;
+		*v4l2_subdev_state_get_crop(sd_state, fmt->pad) = mode->crop;
+	} else {
+		s5k5e3->cur_mode = mode;
+		vblank_def = mode->vts_def - mode->height;
+		__v4l2_ctrl_modify_range(s5k5e3->vblank, vblank_def,
+					 S5K5E3_VTS_MAX - mode->height, 1,
+					 vblank_def);
+		__v4l2_ctrl_s_ctrl(s5k5e3->vblank, vblank_def);
+		h_blank = S5K5E3_PPL - mode->width;
+		__v4l2_ctrl_modify_range(s5k5e3->hblank, h_blank, h_blank, 1,
+					 h_blank);
+	}
+
+	mutex_unlock(&s5k5e3->mutex);
+
+	return 0;
+}
+
+static int s5k5e3_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		mutex_lock(&s5k5e3->mutex);
+		if (sel->which == V4L2_SUBDEV_FORMAT_TRY)
+			sel->r = *v4l2_subdev_state_get_crop(sd_state, sel->pad);
+		else
+			sel->r = s5k5e3->cur_mode->crop;
+		mutex_unlock(&s5k5e3->mutex);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5K5E3_NATIVE_WIDTH;
+		sel->r.height = S5K5E3_NATIVE_HEIGHT;
+		return 0;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = S5K5E3_PIXEL_ARRAY_LEFT;
+		sel->r.top = S5K5E3_PIXEL_ARRAY_TOP;
+		sel->r.width = S5K5E3_PIXEL_ARRAY_WIDTH;
+		sel->r.height = S5K5E3_PIXEL_ARRAY_HEIGHT;
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int s5k5e3_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *sd_state)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.width = supported_modes[0].width,
+			.height = supported_modes[0].height,
+		},
+	};
+
+	mutex_lock(&s5k5e3->mutex);
+	s5k5e3_update_pad_format(s5k5e3, &supported_modes[0], &fmt.format);
+	*v4l2_subdev_state_get_format(sd_state, 0) = fmt.format;
+	*v4l2_subdev_state_get_crop(sd_state, 0) = supported_modes[0].crop;
+	mutex_unlock(&s5k5e3->mutex);
+
+	return 0;
+}
+
+static int s5k5e3_start_streaming(struct s5k5e3 *s5k5e3)
+{
+	const struct s5k5e3_reg_list *reg_list = &s5k5e3->cur_mode->reg_list;
+	int ret;
+
+	ret = cci_multi_reg_write(s5k5e3->regmap, s5k5e3_init_regs,
+				  ARRAY_SIZE(s5k5e3_init_regs), NULL);
+	if (ret) {
+		dev_err(s5k5e3->dev, "failed to write the init registers\n");
+		return ret;
+	}
+
+	ret = cci_multi_reg_write(s5k5e3->regmap, s5k5e3_mode_common_regs,
+				  ARRAY_SIZE(s5k5e3_mode_common_regs), NULL);
+	if (ret) {
+		dev_err(s5k5e3->dev, "failed to set up the PLL and MIPI\n");
+		return ret;
+	}
+
+	ret = cci_multi_reg_write(s5k5e3->regmap, reg_list->regs,
+				  reg_list->num_of_regs, NULL);
+	if (ret) {
+		dev_err(s5k5e3->dev, "failed to set the mode\n");
+		return ret;
+	}
+
+	/* Exposure, gains, blanking, orientation and test pattern */
+	ret = __v4l2_ctrl_handler_setup(s5k5e3->sd.ctrl_handler);
+	if (ret)
+		return ret;
+
+	return cci_write(s5k5e3->regmap, S5K5E3_REG_MODE_SELECT,
+			 S5K5E3_MODE_STREAMING, NULL);
+}
+
+static void s5k5e3_stop_streaming(struct s5k5e3 *s5k5e3)
+{
+	int ret;
+
+	ret = cci_write(s5k5e3->regmap, S5K5E3_REG_MODE_SELECT,
+			S5K5E3_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(s5k5e3->dev, "failed to stop streaming\n");
+}
+
+static int s5k5e3_set_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	int ret = 0;
+
+	mutex_lock(&s5k5e3->mutex);
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(s5k5e3->dev);
+		if (ret < 0)
+			goto unlock;
+
+		ret = s5k5e3_start_streaming(s5k5e3);
+		if (ret) {
+			pm_runtime_put(s5k5e3->dev);
+			goto unlock;
+		}
+	} else {
+		s5k5e3_stop_streaming(s5k5e3);
+		pm_runtime_put(s5k5e3->dev);
+	}
+
+unlock:
+	mutex_unlock(&s5k5e3->mutex);
+
+	return ret;
+}
+
+/*
+ * Vendor sequence: analogue 2.8 V, digital core 1.2 V, I/O 1.8 V, then
+ * reset released, then the 24 MHz clock; a millisecond between the steps.
+ */
+static int s5k5e3_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(S5K5E3_NUM_SUPPLIES, s5k5e3->supplies);
+	if (ret) {
+		dev_err(dev, "failed to enable the supplies\n");
+		return ret;
+	}
+	usleep_range(1000, 1500);
+
+	ret = clk_prepare_enable(s5k5e3->clk);
+	if (ret) {
+		dev_err(dev, "failed to enable the clock\n");
+		regulator_bulk_disable(S5K5E3_NUM_SUPPLIES, s5k5e3->supplies);
+		return ret;
+	}
+	usleep_range(1000, 1500);
+
+	gpiod_set_value_cansleep(s5k5e3->reset_gpio, 0);
+	/* The sensor boots from the first clock edges after reset */
+	usleep_range(10000, 12000);
+
+	return 0;
+}
+
+static int s5k5e3_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+
+	gpiod_set_value_cansleep(s5k5e3->reset_gpio, 1);
+	clk_disable_unprepare(s5k5e3->clk);
+	regulator_bulk_disable(S5K5E3_NUM_SUPPLIES, s5k5e3->supplies);
+
+	return 0;
+}
+
+static int s5k5e3_identify_module(struct s5k5e3 *s5k5e3)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(s5k5e3->regmap, S5K5E3_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(s5k5e3->dev, ret,
+				     "failed to read the chip id\n");
+
+	if (val != S5K5E3_CHIP_ID) {
+		dev_err(s5k5e3->dev, "chip id mismatch: expected 0x%x, read 0x%llx\n",
+			S5K5E3_CHIP_ID, val);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k5e3_video_ops = {
+	.s_stream = s5k5e3_set_stream,
+};
+
+static const struct v4l2_subdev_pad_ops s5k5e3_pad_ops = {
+	.enum_mbus_code = s5k5e3_enum_mbus_code,
+	.get_fmt = s5k5e3_get_pad_format,
+	.set_fmt = s5k5e3_set_pad_format,
+	.enum_frame_size = s5k5e3_enum_frame_size,
+	.get_selection = s5k5e3_get_selection,
+};
+
+static const struct v4l2_subdev_ops s5k5e3_subdev_ops = {
+	.video = &s5k5e3_video_ops,
+	.pad = &s5k5e3_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k5e3_internal_ops = {
+	.init_state = s5k5e3_init_state,
+};
+
+static int s5k5e3_init_controls(struct s5k5e3 *s5k5e3)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5k5e3->ctrl_handler;
+	struct v4l2_fwnode_device_properties props;
+	const struct s5k5e3_mode *mode = s5k5e3->cur_mode;
+	s64 vblank_def = mode->vts_def - mode->height;
+	s64 h_blank = S5K5E3_PPL - mode->width;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 12);
+	if (ret)
+		return ret;
+
+	mutex_init(&s5k5e3->mutex);
+	ctrl_hdlr->lock = &s5k5e3->mutex;
+
+	s5k5e3->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &s5k5e3_ctrl_ops,
+						   V4L2_CID_LINK_FREQ,
+						   ARRAY_SIZE(s5k5e3_link_freq_menu) - 1,
+						   0, s5k5e3_link_freq_menu);
+	if (s5k5e3->link_freq)
+		s5k5e3->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k5e3->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &s5k5e3_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       S5K5E3_PIXEL_RATE,
+					       S5K5E3_PIXEL_RATE, 1,
+					       S5K5E3_PIXEL_RATE);
+	if (s5k5e3->pixel_rate)
+		s5k5e3->pixel_rate->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k5e3->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k5e3_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5k5e3->hflip)
+		s5k5e3->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k5e3->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5k5e3_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5k5e3->vflip)
+		s5k5e3->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5k5e3->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k5e3_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank_def,
+					   S5K5E3_VTS_MAX - mode->height, 1,
+					   vblank_def);
+
+	s5k5e3->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5k5e3_ctrl_ops,
+					   V4L2_CID_HBLANK, h_blank, h_blank,
+					   1, h_blank);
+	if (s5k5e3->hblank)
+		s5k5e3->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k5e3->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &s5k5e3_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5K5E3_EXPOSURE_MIN,
+					     mode->vts_def - S5K5E3_EXPOSURE_OFFSET,
+					     S5K5E3_EXPOSURE_STEP,
+					     S5K5E3_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &s5k5e3_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5K5E3_ANA_GAIN_MIN, S5K5E3_ANA_GAIN_MAX,
+			  S5K5E3_ANA_GAIN_STEP, S5K5E3_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &s5k5e3_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  S5K5E3_DGTL_GAIN_MIN, S5K5E3_DGTL_GAIN_MAX,
+			  S5K5E3_DGTL_GAIN_STEP, S5K5E3_DGTL_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &s5k5e3_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5k5e3_test_pattern_menu) - 1,
+				     0, 0, s5k5e3_test_pattern_menu);
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		dev_err(s5k5e3->dev, "control init failed (%d)\n", ret);
+		goto error;
+	}
+
+	ret = v4l2_fwnode_device_parse(s5k5e3->dev, &props);
+	if (ret)
+		goto error;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &s5k5e3_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error;
+
+	s5k5e3->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+	mutex_destroy(&s5k5e3->mutex);
+
+	return ret;
+}
+
+static int s5k5e3_check_hwcfg(struct s5k5e3 *s5k5e3)
+{
+	struct v4l2_fwnode_endpoint ep = { .bus_type = V4L2_MBUS_CSI2_DPHY };
+	struct fwnode_handle *endpoint;
+	unsigned long link_freq_bitmap;
+	int ret;
+
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(s5k5e3->dev), NULL);
+	if (!endpoint)
+		return dev_err_probe(s5k5e3->dev, -EINVAL,
+				     "endpoint node not found\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &ep);
+	fwnode_handle_put(endpoint);
+	if (ret)
+		return dev_err_probe(s5k5e3->dev, ret,
+				     "parsing the endpoint failed\n");
+
+	if (ep.bus.mipi_csi2.num_data_lanes != 2) {
+		ret = dev_err_probe(s5k5e3->dev, -EINVAL,
+				    "only two data lanes are supported\n");
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5k5e3->dev, ep.link_frequencies,
+				       ep.nr_of_link_frequencies,
+				       s5k5e3_link_freq_menu,
+				       ARRAY_SIZE(s5k5e3_link_freq_menu),
+				       &link_freq_bitmap);
+out:
+	v4l2_fwnode_endpoint_free(&ep);
+
+	return ret;
+}
+
+static int s5k5e3_probe(struct i2c_client *client)
+{
+	struct s5k5e3 *s5k5e3;
+	unsigned int i;
+	int ret;
+
+	s5k5e3 = devm_kzalloc(&client->dev, sizeof(*s5k5e3), GFP_KERNEL);
+	if (!s5k5e3)
+		return -ENOMEM;
+
+	s5k5e3->dev = &client->dev;
+
+	s5k5e3->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k5e3->regmap))
+		return dev_err_probe(s5k5e3->dev, PTR_ERR(s5k5e3->regmap),
+				     "failed to initialise CCI\n");
+
+	ret = s5k5e3_check_hwcfg(s5k5e3);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < S5K5E3_NUM_SUPPLIES; i++)
+		s5k5e3->supplies[i].supply = s5k5e3_supply_name[i];
+	ret = devm_regulator_bulk_get(s5k5e3->dev, S5K5E3_NUM_SUPPLIES,
+				      s5k5e3->supplies);
+	if (ret)
+		return dev_err_probe(s5k5e3->dev, ret,
+				     "failed to get the supplies\n");
+
+	/* XSHUTDOWN, held asserted until the supplies and the clock are up */
+	s5k5e3->reset_gpio = devm_gpiod_get_optional(s5k5e3->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k5e3->reset_gpio))
+		return dev_err_probe(s5k5e3->dev, PTR_ERR(s5k5e3->reset_gpio),
+				     "failed to get the reset GPIO\n");
+
+	s5k5e3->clk = devm_v4l2_sensor_clk_get_legacy(s5k5e3->dev, NULL, false,
+						      S5K5E3_MCLK_RATE);
+	if (IS_ERR(s5k5e3->clk))
+		return dev_err_probe(s5k5e3->dev, PTR_ERR(s5k5e3->clk),
+				     "failed to get the clock\n");
+	if (clk_get_rate(s5k5e3->clk) != S5K5E3_MCLK_RATE)
+		return dev_err_probe(s5k5e3->dev, -EINVAL,
+				     "the clock must run at 24 MHz, not %lu\n",
+				     clk_get_rate(s5k5e3->clk));
+
+	v4l2_i2c_subdev_init(&s5k5e3->sd, client, &s5k5e3_subdev_ops);
+
+	/* Powered off again by pm_runtime_idle() */
+	ret = s5k5e3_power_on(s5k5e3->dev);
+	if (ret)
+		return ret;
+
+	ret = s5k5e3_identify_module(s5k5e3);
+	if (ret)
+		goto error_power_off;
+
+	s5k5e3->cur_mode = &supported_modes[0];
+
+	ret = s5k5e3_init_controls(s5k5e3);
+	if (ret)
+		goto error_power_off;
+
+	s5k5e3->sd.internal_ops = &s5k5e3_internal_ops;
+	s5k5e3->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k5e3->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5k5e3->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5k5e3->sd.entity, 1, &s5k5e3->pad);
+	if (ret)
+		goto error_handler_free;
+
+	ret = v4l2_async_register_subdev_sensor(&s5k5e3->sd);
+	if (ret < 0)
+		goto error_media_entity;
+
+	pm_runtime_set_active(s5k5e3->dev);
+	pm_runtime_enable(s5k5e3->dev);
+	pm_runtime_idle(s5k5e3->dev);
+
+	return 0;
+
+error_media_entity:
+	media_entity_cleanup(&s5k5e3->sd.entity);
+
+error_handler_free:
+	v4l2_ctrl_handler_free(s5k5e3->sd.ctrl_handler);
+	mutex_destroy(&s5k5e3->mutex);
+
+error_power_off:
+	s5k5e3_power_off(s5k5e3->dev);
+
+	return ret;
+}
+
+static void s5k5e3_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k5e3 *s5k5e3 = to_s5k5e3(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	mutex_destroy(&s5k5e3->mutex);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		s5k5e3_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
