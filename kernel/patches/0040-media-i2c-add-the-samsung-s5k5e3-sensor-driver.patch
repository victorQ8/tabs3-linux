+#define S5K5E3_DGTL_GAIN_MAX		4095
+#define S5K5E3_DGTL_GAIN_STEP		1
+#define S5K5E3_DGTL_GAIN_DEFAULT	256
+
+#define S5K5E3_REG_FRAME_LENGTH		CCI_REG16(0x0340)
+#define S5K5E3_REG_LINE_LENGTH		CCI_REG16(0x0342)
+#define S5K5E3_VTS_MAX			0xffff
+/* Every mode of this configuration uses the same line length */
+#define S5K5E3_PPL			2950
+
+#define S5K5E3_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define S5K5E3_MCLK_RATE		24000000
+/* 896 Mbps per lane on two lanes */
+#define S5K5E3_LINK_FREQ		448000000ULL
+/* link frequency * 2 (DDR) * 2 lanes / 10 bits */
+#define S5K5E3_PIXEL_RATE		179200000
+
+#define S5K5E3_NATIVE_WIDTH		2576
+#define S5K5E3_NATIVE_HEIGHT		1936
+#define S5K5E3_PIXEL_ARRAY_LEFT		0
+#define S5K5E3_PIXEL_ARRAY_TOP		2
+#define S5K5E3_PIXEL_ARRAY_WIDTH	2576
+#define S5K5E3_PIXEL_ARRAY_HEIGHT	1932
+
+static const char * const s5k5e3_supply_name[] = {
+	"vana",		/* analogue, 2.8 V */
+	"vdig",		/* digital core, 1.2 V */
+	"vio",		/* I/O, 1.8 V */
+};
+
+#define S5K5E3_NUM_SUPPLIES ARRAY_SIZE(s5k5e3_supply_name)
+
+struct s5k5e3_reg_list {
+	u32 num_of_regs;
+	const struct cci_reg_sequence *regs;
+};
+
+struct s5k5e3_mode {
+	u32 width;
+	u32 height;
+	/* Default frame length in lines */
+	u32 vts_def;
+	/* Analogue crop before binning */
+	struct v4l2_rect crop;
+	struct s5k5e3_reg_list reg_list;
+};
+
