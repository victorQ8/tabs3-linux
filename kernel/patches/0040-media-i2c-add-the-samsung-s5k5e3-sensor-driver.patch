+	{ CCI_REG8(0x3045), 0x01 }, { CCI_REG8(0x3046), 0x05 },
+	{ CCI_REG8(0x3047), 0x78 }, { CCI_REG8(0x307f), 0xb1 },
+	{ CCI_REG8(0x3098), 0x01 }, { CCI_REG8(0x305c), 0xf6 },
+	{ CCI_REG8(0x3063), 0x2f }, { CCI_REG8(0x3400), 0x01 },
