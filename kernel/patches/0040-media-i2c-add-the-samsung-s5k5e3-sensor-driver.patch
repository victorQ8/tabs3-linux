+	{ CCI_REG8(0x3234), 0x00 }, { CCI_REG8(0x3300), 0x0c },
+	{ CCI_REG8(0x3203), 0x45 }, { CCI_REG8(0x3205), 0x4d },
+	{ CCI_REG8(0x320b), 0x40 }, { CCI_REG8(0x320c), 0x06 },
+	{ CCI_REG8(0x320d), 0xc0 }, { CCI_REG8(0x3244), 0x00 },
+	{ CCI_REG8(0x3245), 0x00 }, { CCI_REG8(0x3246), 0x01 },
+	{ CCI_REG8(0x3247), 0x00 }, { CCI_REG8(0x3268), 0x88 },
