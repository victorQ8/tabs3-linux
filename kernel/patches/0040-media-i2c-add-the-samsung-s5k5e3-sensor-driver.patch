+			.left = S5K5E3_PIXEL_ARRAY_LEFT,
+			.top = S5K5E3_PIXEL_ARRAY_TOP,
+			.width = 2576,
+			.height = 1932,
+		},
+		.reg_list = {
+			.num_of_regs = ARRAY_SIZE(s5k5e3_mode_2576x1932_regs),
+			.regs = s5k5e3_mode_2576x1932_regs,
+		},
+	},
+	{
+		.width = 640,
+		.height = 480,
+		.vts_def = 506,
+		.crop = {
+			.left = 8,
+			.top = 8,
+			.width = 2560,
+			.height = 1920,
+		},
