+
+static const struct iio_chan_spec smgr_light_iio_channels[] = {
+	{
+		.type = IIO_LIGHT,
+		.scan_index = 0,
+		.scan_type = {
+			.sign = 'u',
+			.realbits = 32,
+			.storagebits = 32,
+			.endianness = IIO_LE,
+		},
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |
+				      BIT(IIO_CHAN_INFO_SCALE) |
+				      BIT(IIO_CHAN_INFO_SAMP_FREQ),
+		.info_mask_separate_available = BIT(IIO_CHAN_INFO_SAMP_FREQ),
+	},
+	IIO_CHAN_SOFT_TIMESTAMP(1),
+};
+
+static int smgr_light_probe(struct platform_device *pdev)
+{
+	struct iio_dev *iio_dev;
+	struct smgr_iio_priv *priv;
+	struct smgr_sensor *sensor;
+	int ret;
+
+	sensor = *(struct smgr_sensor **)pdev->dev.platform_data;
+	if (!sensor->data_type_count || !sensor->data_types[0].name ||
+	    !strstr(sensor->data_types[0].name, "ALS"))
+		return dev_err_probe(&pdev->dev, -ENODEV,
+				     "first data type is not an ambient light sensor\n");
+
+	iio_dev = devm_iio_device_alloc(&pdev->dev, sizeof(*priv));
+	if (!iio_dev)
+		return -ENOMEM;
+
+	priv = iio_priv(iio_dev);
+	priv->sensor = sensor;
+	priv->sensor->iio_dev = iio_dev;
+	platform_set_drvdata(pdev, iio_dev);
+
+	iio_dev->name = "qcom-smgr-light";
+	iio_dev->info = &smgr_light_iio_info;
+	iio_dev->channels = smgr_light_iio_channels;
+	iio_dev->num_channels = ARRAY_SIZE(smgr_light_iio_channels);
+
+	ret = devm_iio_kfifo_buffer_setup(&pdev->dev, iio_dev,
+					  &smgr_buffer_ops);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "Failed to setup buffer\n");
+
+	ret = devm_iio_device_register(&pdev->dev, iio_dev);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "Failed to register IIO device\n");
+
+	return 0;
+}
+
+static void smgr_light_remove(struct platform_device *pdev)
+{
+	struct iio_dev *iio_dev = platform_get_drvdata(pdev);
+	struct smgr_iio_priv *priv = iio_priv(iio_dev);
+
+	priv->sensor->iio_dev = NULL;
+}
+
+static const struct platform_device_id smgr_light_ids[] = {
+	{ .name = "qcom-smgr-prox-light" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(platform, smgr_light_ids);
+
+static struct platform_driver smgr_light_driver = {
+	.probe = smgr_light_probe,
+	.remove = smgr_light_remove,
+	.driver	= {
+		.name = "smgr_light",
+	},
+	.id_table = smgr_light_ids,
+};
+module_platform_driver(smgr_light_driver);
+
+MODULE_DESCRIPTION("Qualcomm Sensor Manager ambient light sensor driver");
+MODULE_LICENSE("GPL");
