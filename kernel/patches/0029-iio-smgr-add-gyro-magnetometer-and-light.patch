--- /dev/null
+++ b/drivers/iio/gyro/smgr_gyro.c
@@ -0,0 +1,181 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Qualcomm Sensor Manager gyroscope driver
+ *
+ * Derived from the Sensor Manager accelerometer driver,
+ * Copyright (c) 2022, Yassine Oudjana <y.oudjana@protonmail.com>
+ *
+ * The Sensor Manager reports angular rates as Q16 rad/s in the sensor
+ * core's frame; the first data type of the gyroscope carries them.
+ */
+
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/iio/buffer.h>
+#include <linux/iio/common/qcom_smgr.h>
+#include <linux/iio/iio.h>
+#include <linux/iio/kfifo_buf.h>
+
+static int smgr_gyro_read_raw(struct iio_dev *iio_dev,
+			      struct iio_chan_spec const *chan, int *val,
+			      int *val2, long mask)
+{
+	struct smgr_iio_priv *priv = iio_priv(iio_dev);
+	int ret;
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+		if (!iio_device_claim_direct(iio_dev))
+			return -EBUSY;
+		ret = smgr_sensor_read(priv->sensor, chan->scan_index, val);
+		iio_device_release_direct(iio_dev);
+		return ret;
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		*val = priv->sensor->data_types[0].cur_sample_rate;
+		return IIO_VAL_INT;
+	case IIO_CHAN_INFO_SCALE:
+		/* Q16 rad/s */
+		*val = 1;
+		*val2 = 16;
+		return IIO_VAL_FRACTIONAL_LOG2;
+	}
+
+	return -EINVAL;
+}
+
+static int smgr_gyro_write_raw(struct iio_dev *iio_dev,
+			       struct iio_chan_spec const *chan, int val,
+			       int val2, long mask)
+{
+	struct smgr_iio_priv *priv = iio_priv(iio_dev);
+
+	switch (mask) {
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		if (val < 1 || val > priv->sensor->data_types[0].max_sample_rate)
+			return -EINVAL;
+		priv->sensor->data_types[0].cur_sample_rate = val;
+
+		/* Send a new buffering request if the buffer is enabled */
+		if (iio_buffer_enabled(iio_dev))
+			return iio_dev->setup_ops->postenable(iio_dev);
+
+		return 0;
+	}
+
+	return -EINVAL;
+}
+
+static int smgr_gyro_read_avail(struct iio_dev *iio_dev,
+				struct iio_chan_spec const *chan,
+				const int **vals, int *type, int *length,
+				long mask)
+{
+	struct smgr_iio_priv *priv = iio_priv(iio_dev);
+
+	switch (mask) {
+	case IIO_CHAN_INFO_SAMP_FREQ:
+		priv->samp_freq_range[0] = 1;
+		priv->samp_freq_range[1] = 1;
+		priv->samp_freq_range[2] =
+			priv->sensor->data_types[0].max_sample_rate;
+		*type = IIO_VAL_INT;
+		*vals = priv->samp_freq_range;
+		*length = ARRAY_SIZE(priv->samp_freq_range);
+		return IIO_AVAIL_RANGE;
+	}
+
+	return -EINVAL;
+}
+
+static const struct iio_info smgr_gyro_iio_info = {
+	.read_raw = smgr_gyro_read_raw,
+	.write_raw = smgr_gyro_write_raw,
+	.read_avail = smgr_gyro_read_avail,
+};
+
+#define SMGR_GYRO_CHANNEL(_axis, _index)				\
+	{								\
+		.type = IIO_ANGL_VEL,					\
+		.modified = true,					\
+		.channel2 = IIO_MOD_##_axis,				\
+		.scan_index = _index,					\
+		.scan_type = {						\
+			.sign = 's',					\
+			.realbits = 32,					\
+			.storagebits = 32,				\
+			.endianness = IIO_LE,				\
+		},							\
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),		\
+		.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_SCALE) |	\
+					    BIT(IIO_CHAN_INFO_SAMP_FREQ), \
+		.info_mask_shared_by_type_available =			\
+					    BIT(IIO_CHAN_INFO_SAMP_FREQ), \
+	}
+
+static const struct iio_chan_spec smgr_gyro_iio_channels[] = {
+	SMGR_GYRO_CHANNEL(X, 0),
+	SMGR_GYRO_CHANNEL(Y, 1),
+	SMGR_GYRO_CHANNEL(Z, 2),
+	IIO_CHAN_SOFT_TIMESTAMP(3),
+};
+
+static int smgr_gyro_probe(struct platform_device *pdev)
+{
+	struct iio_dev *iio_dev;
+	struct smgr_iio_priv *priv;
+	int ret;
+
+	iio_dev = devm_iio_device_alloc(&pdev->dev, sizeof(*priv));
+	if (!iio_dev)
+		return -ENOMEM;
+
+	priv = iio_priv(iio_dev);
+	priv->sensor = *(struct smgr_sensor **)pdev->dev.platform_data;
+	priv->sensor->iio_dev = iio_dev;
+	platform_set_drvdata(pdev, iio_dev);
+
+	iio_dev->name = "qcom-smgr-gyro";
+	iio_dev->info = &smgr_gyro_iio_info;
+	iio_dev->channels = smgr_gyro_iio_channels;
+	iio_dev->num_channels = ARRAY_SIZE(smgr_gyro_iio_channels);
+
+	ret = devm_iio_kfifo_buffer_setup(&pdev->dev, iio_dev,
+					  &smgr_buffer_ops);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "Failed to setup buffer\n");
+
+	ret = devm_iio_device_register(&pdev->dev, iio_dev);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "Failed to register IIO device\n");
+
+	return 0;
+}
+
+static void smgr_gyro_remove(struct platform_device *pdev)
+{
+	struct iio_dev *iio_dev = platform_get_drvdata(pdev);
+	struct smgr_iio_priv *priv = iio_priv(iio_dev);
+
+	priv->sensor->iio_dev = NULL;
+}
+
+static const struct platform_device_id smgr_gyro_ids[] = {
+	{ .name = "qcom-smgr-gyro" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(platform, smgr_gyro_ids);
+
+static struct platform_driver smgr_gyro_driver = {
+	.probe = smgr_gyro_probe,
+	.remove = smgr_gyro_remove,
+	.driver	= {
+		.name = "smgr_gyro",
+	},
+	.id_table = smgr_gyro_ids,
+};
+module_platform_driver(smgr_gyro_driver);
+
+MODULE_DESCRIPTION("Qualcomm Sensor Manager gyroscope driver");
+MODULE_LICENSE("GPL");
