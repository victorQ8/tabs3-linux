+
+/* Reject open/short or uncalibrated readings instead of inventing a temperature. */
+static int gts3l_skin_convert(int raw, int *temp)
+{
+	unsigned int i;
+	const unsigned int count = sizeof(gts3l_skin_table) / sizeof(gts3l_skin_table[0]);
+
+	if (raw < gts3l_skin_table[0].adc || raw > gts3l_skin_table[count - 1].adc)
+		return -1;
+	for (i = 1; i < count; i++) {
+		const struct gts3l_skin_point *a = &gts3l_skin_table[i - 1];
+		const struct gts3l_skin_point *b = &gts3l_skin_table[i];
+
+		if (raw <= b->adc) {
+			*temp = a->mc + (raw - a->adc) * (b->mc - a->mc) /
+				(b->adc - a->adc);
+			return 0;
+		}
+	}
+	return -1;
+}
+#endif
--- /dev/null
+++ b/drivers/thermal/gts3l-skin-thermal.c
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* SM-T825 AP/skin thermistor using Samsung's raw-code calibration. */
+#include <linux/iio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+#include "gts3l-skin-table.h"
+
+struct gts3l_skin {
+	struct iio_channel *adc;
+};
+
+static int gts3l_skin_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct gts3l_skin *skin = thermal_zone_device_priv(tz);
+	int raw, ret;
+
+	ret = iio_read_channel_raw(skin->adc, &raw);
+	if (ret < 0)
+		return ret;
+	if (gts3l_skin_convert(raw, temp))
+		return -ERANGE;
+	return 0;
+}
+
+static const struct thermal_zone_device_ops gts3l_skin_ops = {
+	.get_temp = gts3l_skin_get_temp,
+};
+
+static int gts3l_skin_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct thermal_zone_device *tz;
+	struct gts3l_skin *skin;
+
+	skin = devm_kzalloc(dev, sizeof(*skin), GFP_KERNEL);
+	if (!skin)
+		return -ENOMEM;
+	skin->adc = devm_iio_channel_get(dev, "skin");
+	if (IS_ERR(skin->adc))
+		return dev_err_probe(dev, PTR_ERR(skin->adc), "skin ADC unavailable\n");
+	tz = devm_thermal_of_zone_register(dev, 0, skin, &gts3l_skin_ops);
+	return PTR_ERR_OR_ZERO(tz);
+}
+
+static const struct of_device_id gts3l_skin_match[] = {
+	{ .compatible = "samsung,gts3l-ap-thermistor" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, gts3l_skin_match);
+
+static struct platform_driver gts3l_skin_driver = {
+	.probe = gts3l_skin_probe,
+	.driver = {
+		.name = "gts3l-skin-thermal",
+		.of_match_table = gts3l_skin_match,
+	},
+};
+module_platform_driver(gts3l_skin_driver);
+MODULE_DESCRIPTION("SM-T825 raw VADC AP thermistor");
+MODULE_LICENSE("GPL");
