Subject: [PATCH] thermal: add calibrated raw VADC AP thermistor for SM-T825

The stock table maps raw VADC 0x73 codes to tenths of a degree.
The generic ADC thermal driver reads processed values, so passing this
raw table to it would apply the wrong conversion. Use the raw IIO API and
the exact 111 stock calibration points, returning milliCelsius to thermal.
Out-of-table readings are reported as errors. This is a board-local driver;
measured chassis temperatures and cooling policy still need validation.

--- a/drivers/thermal/Kconfig
+++ b/drivers/thermal/Kconfig
@@ -464,6 +464,13 @@
 
 source "drivers/thermal/tegra/Kconfig"
 
+config GTS3L_SKIN_THERMAL
+	tristate "Samsung Galaxy Tab S3 AP thermistor"
+	depends on IIO && THERMAL_OF
+	help
+	  Read the SM-T825 AP thermistor using its stock raw VADC calibration.
+	  This complements the SoC junction and battery thermal protections.
+
 config GENERIC_ADC_THERMAL
 	tristate "Generic ADC based thermal sensor"
 	depends on IIO
--- a/drivers/thermal/Makefile
+++ b/drivers/thermal/Makefile
@@ -61,6 +61,7 @@
 obj-y				+= tegra/
 obj-$(CONFIG_HISI_THERMAL)     += hisi_thermal.o
 obj-y				+= mediatek/
+obj-$(CONFIG_GTS3L_SKIN_THERMAL)	+= gts3l-skin-thermal.o
 obj-$(CONFIG_GENERIC_ADC_THERMAL)	+= thermal-generic-adc.o
 obj-$(CONFIG_UNIPHIER_THERMAL)	+= uniphier_thermal.o
 obj-$(CONFIG_AMLOGIC_THERMAL)     += amlogic_thermal.o
--- /dev/null
+++ b/drivers/thermal/gts3l-skin-table.h
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Samsung SM-T825 stock AP thermistor table: raw VADC codes and milliCelsius.
+ * The stock temp_array is in tenths of a degree. Do not apply it to the
+ * VADC driver's generic processed thermistor temperatures.
+ */
