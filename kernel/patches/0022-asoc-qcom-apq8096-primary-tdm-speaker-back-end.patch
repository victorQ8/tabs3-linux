Subject: [PATCH] ASoC: qcom: apq8096: primary TDM speaker back end

The SM-T825's speaker amplifiers sit on the primary TDM interface, which
the apq8096 machine driver does not handle: every back end gets the
SLIMbus channel map and the WCD9335 clock, two channels, and no TDM slots
or bit clock.

For a PRIMARY_TDM_RX_0 back end, use four channels in four 16-bit slots
and enable the 3.072 MHz primary TDM bit clock while the stream is open.
As on the vendor kernel, no slot mapping is set: with a single TDM group
the channels fill the slots in order. Other back ends keep the SLIMbus
setup.

Assisted-by: Claude:claude-opus-5-5

--- a/sound/soc/qcom/apq8096.c
+++ b/sound/soc/qcom/apq8096.c
@@ -1,19 +1,32 @@
 // SPDX-License-Identifier: GPL-2.0
 // Copyright (c) 2018, Linaro Limited
 
+#include <linux/bits.h>
 #include <linux/mod_devicetable.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
 #include <sound/soc.h>
 #include <sound/soc-dapm.h>
 #include <sound/pcm.h>
 #include <sound/pcm_params.h>
 #include "common.h"
+#include "qdsp6/q6afe.h"
 
 #define SLIM_MAX_TX_PORTS 16
 #define SLIM_MAX_RX_PORTS 16
 #define WCD9335_DEFAULT_MCLK_RATE	9600000
 
+/* Primary TDM: four 16-bit slots at 48 kHz, bit clock from the SoC */
+#define TDM_SLOTS		4
+#define TDM_SLOT_WIDTH		16
+#define TDM_BCLK_RATE		(48000 * TDM_SLOTS * TDM_SLOT_WIDTH)
+
+static bool apq8096_is_tdm(struct snd_soc_pcm_runtime *rtd)
+{
+	return rtd->dai_link->id == PRIMARY_TDM_RX_0;
+}
+
 static int apq8096_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				      struct snd_pcm_hw_params *params)
 {
@@ -24,7 +37,7 @@
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
 
 	rate->min = rate->max = 48000;
-	channels->min = channels->max = 2;
+	channels->min = channels->max = apq8096_is_tdm(rtd) ? TDM_SLOTS : 2;
 	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
 
 	return 0;
@@ -67,6 +80,45 @@
 	.hw_params = msm_snd_hw_params,
 };
 
+static int apq8096_tdm_startup(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+	return snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT,
+				      TDM_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+}
+
+static void apq8096_tdm_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+
+	snd_soc_dai_set_sysclk(cpu_dai, Q6AFE_LPASS_CLK_ID_PRI_TDM_IBIT, 0,
+			       SNDRV_PCM_STREAM_PLAYBACK);
+}
+
+static int apq8096_tdm_hw_params(struct snd_pcm_substream *substream,
+				 struct snd_pcm_hw_params *params)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	unsigned int channels = params_channels(params);
+
+	/*
+	 * Channels fill the slots in order. As on stock, no slot mapping is
+	 * set: this DSP rejects one for a single TDM group.
+	 */
+	return snd_soc_dai_set_tdm_slot(cpu_dai, 0, GENMASK(channels - 1, 0),
+					TDM_SLOTS, TDM_SLOT_WIDTH);
+}
+
+static const struct snd_soc_ops apq8096_tdm_ops = {
+	.startup = apq8096_tdm_startup,
+	.shutdown = apq8096_tdm_shutdown,
+	.hw_params = apq8096_tdm_hw_params,
+};
+
 static int apq8096_init(struct snd_soc_pcm_runtime *rtd)
 {
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
@@ -98,8 +150,12 @@
 	int i;
 
 	for_each_card_prelinks(card, i, link) {
-		if (link->no_pcm == 1) {
-			link->be_hw_params_fixup = apq8096_be_hw_params_fixup;
+		if (link->no_pcm != 1)
+			continue;
+		link->be_hw_params_fixup = apq8096_be_hw_params_fixup;
+		if (link->id == PRIMARY_TDM_RX_0) {
+			link->ops = &apq8096_tdm_ops;
+		} else {
 			link->init = apq8096_init;
 			link->ops = &apq8096_ops;
 		}
