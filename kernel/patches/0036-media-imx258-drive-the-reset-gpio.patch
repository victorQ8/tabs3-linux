From: tabS3 bring-up <noreply@localhost>
Subject: [PATCH] media: i2c: imx258: drive the reset GPIO

The binding documents reset-gpios (XCLR) but the driver never requests
it, so a board must park XCLR high and rely on the software reset at
stream start. Hold XCLR low until the supplies and INCK are enabled,
release it in power_on() and give the sensor 12 ms to boot; assert it
again before the clock and supplies go off.

Assisted-by: Claude:claude-fable-5-1
---
--- a/drivers/media/i2c/imx258.c	2026-10-13 22:49:58.447180664 +0300
+++ b/drivers/media/i2c/imx258.c	2026-10-13 22:49:58.489414424 +0300
@@ -4,6 +4,7 @@
 #include <linux/acpi.h>
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
@@ -680,6 +681,7 @@
 	struct mutex mutex;
 
 	struct clk *clk;
+	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data supplies[IMX258_NUM_SUPPLIES];
 };
 
@@ -1116,9 +1118,14 @@
 	if (ret) {
 		dev_err(dev, "failed to enable clock\n");
 		regulator_bulk_disable(IMX258_NUM_SUPPLIES, imx258->supplies);
+		return ret;
 	}
 
-	return ret;
+	/* Release XCLR after the supplies and INCK, then let the sensor boot */
+	gpiod_set_value_cansleep(imx258->reset_gpio, 0);
+	usleep_range(12000, 15000);
+
+	return 0;
 }
 
 static int imx258_power_off(struct device *dev)
@@ -1126,6 +1133,7 @@
 	struct v4l2_subdev *sd = dev_get_drvdata(dev);
 	struct imx258 *imx258 = to_imx258(sd);
 
+	gpiod_set_value_cansleep(imx258->reset_gpio, 1);
 	clk_disable_unprepare(imx258->clk);
 	regulator_bulk_disable(IMX258_NUM_SUPPLIES, imx258->supplies);
 
@@ -1375,6 +1383,13 @@
 		return dev_err_probe(imx258->dev, ret,
 				     "failed to get regulators\n");
 
+	/* XCLR, held low (asserted) until the supplies and INCK are up */
+	imx258->reset_gpio = devm_gpiod_get_optional(imx258->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(imx258->reset_gpio))
+		return dev_err_probe(imx258->dev, PTR_ERR(imx258->reset_gpio),
+				     "failed to get reset GPIO\n");
+
 	imx258->clk = devm_v4l2_sensor_clk_get_legacy(imx258->dev, NULL, false,
 						      0);
 	if (IS_ERR(imx258->clk))
