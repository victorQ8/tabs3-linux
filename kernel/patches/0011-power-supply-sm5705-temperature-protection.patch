+static int sm5705_read_temperature(struct iio_channel *channel, bool charger, int *temp)
+{
+	int raw, ret = iio_read_channel_raw(channel, &raw);
+
+	if (ret < 0)
+		return ret;
+	return sm5705_temperature(raw, charger, temp) ? 0 : -ERANGE;
+}
+
+static int sm5705_enable(struct sm5705_chg *chg, bool enable)
+{
+	int ret = gpiod_set_value_cansleep(chg->enable, enable);
+
+	if (ret)
+		return ret;
+	ret = gpiod_get_value_cansleep(chg->enable);
+	return ret < 0 ? ret : ret == enable ? 0 : -EIO;
+}
+
+/* Read back every setting. An error is retried on the next policy pass;
+ * preserve unrelated register bits and never cache an unconfirmed write.
+ */
+static int sm5705_update_verified(struct sm5705_chg *chg, u8 reg, u8 mask, u8 value)
+{
+	u8 old, check;
+	int ret = sm5705_chg_read(chg, reg, &old);
+
+	if (ret)
+		return ret;
+	if ((old & mask) == value)
+		return 0;
+	ret = i2c_smbus_write_byte_data(chg->client, reg, (old & ~mask) | value);
+	if (ret)
+		return ret;
+	ret = sm5705_chg_read(chg, reg, &check);
+	return ret ? ret : (check & mask) == value ? 0 : -EIO;
+}
+
+/* Called with lock held. Unknown ports, invalid sensors, charger faults or
+ * failed register operations inhibit charging through the separate GPIO.
+ */
+static int sm5705_apply_policy(struct sm5705_chg *chg)
+{
+	struct sm5705_limits limits;
+	u8 s1 = 0, s2 = 0, s3 = 0, voltage;
+	int ret, t1, t2, type, source = 100000;
+	bool valid;
+
+	ret = sm5705_chg_status(chg, &s1, &s2, &s3);
+	t1 = sm5705_read_temperature(chg->battery_therm, false, &chg->battery_temp);
+	t2 = sm5705_read_temperature(chg->charger_therm, true, &chg->charger_temp);
+	chg->temp_valid = !t1 && !t2;
+	valid = !ret && chg->temp_valid &&
+		!(s1 & SM5705_STATUS1_VBUSOVP) &&
+		!(s2 & (SM5705_STATUS2_BATOVP | SM5705_STATUS2_NOBAT | SM5705_STATUS2_WDTMROFF)) &&
+		!(s3 & (SM5705_STATUS3_THEMSHDN | SM5705_STATUS3_PRETMROFF | SM5705_STATUS3_FASTTMROFF));
+	if (!ret && (s1 & SM5705_STATUS1_VBUSPOK)) {
+		type = sm5705_chg_usb_type(chg);
+		if (type == POWER_SUPPLY_USB_TYPE_SDP)
+			source = 500000;
+		else if (type == POWER_SUPPLY_USB_TYPE_CDP || type == POWER_SUPPLY_USB_TYPE_DCP)
+			source = 1500000;
+	}
+	limits = sm5705_choose_limits(&chg->safety, valid, chg->battery_temp,
+			chg->charger_temp, source, chg->user_limit,
+			READ_ONCE(auto_input_limit), chg->inhibit);
+	if (!limits.enable) {
+		ret = sm5705_enable(chg, false);
+		if (ret)
+			goto fail;
+	}
+	ret = sm5705_update_verified(chg, SM5705_VBUSCNTL, 0x7f,
+				    (limits.input_ua / 1000 - 100) / 25);
+	if (ret)
+		goto fail;
+	ret = sm5705_update_verified(chg, SM5705_CHGCNTL2, 0x3f,
+				    (limits.charge_ua / 1000 - 100) / 50);
+	if (ret)
+		goto fail;
+	/* Retain lower stock/age limits; never enable with float above 4.38 V. */
+	ret = sm5705_chg_read(chg, SM5705_CHGCNTL4, &voltage);
+	if (ret)
+		goto fail;
+	if ((voltage & 0x3f) > 39) {
+		ret = -ERANGE;
+		goto fail;
+	}
+	ret = sm5705_enable(chg, limits.enable);
+	if (ret)
+		goto fail;
+	return 0;
+fail:
+	if (sm5705_enable(chg, false))
+		dev_err_ratelimited(&chg->client->dev, "cannot confirm charging disabled\n");
+	/* Best effort conservative input even if the enable GPIO failed. */
+	sm5705_update_verified(chg, SM5705_VBUSCNTL, 0x7f, 0);
+	chg->safety.blocked = true;
+	dev_err_ratelimited(&chg->client->dev, "charging inhibited after control error %d\n", ret);
+	return ret;
+}
