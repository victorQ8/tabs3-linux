#!/usr/bin/python3
"""Server status on the Tab S3 LTE's own panel, plus a presence wake.

Draws straight into the panel's framebuffer (no compositor, no web page):
clock, uptime, load, CPU and temperatures, battery, memory, storage, the
network addresses and rates, logins, the remote processors and the light
sensor, with ten-minute history. Rendering pauses while the screen sleeps
(tabs3-screen blanks it after an idle time).

While the screen is off it watches the light sensor, the accelerometer,
the microphone and the front camera: a sudden change of the illuminance (a
shadow, a light switched on), a jolt felt by the tablet, a sound well above
the room's floor or a change in the camera's coarse view of the room asks
tabs3-screen to wake the screen, as a touch would. Settings:
/etc/tabs3/dashboard.conf.
"""
import argparse
import array
import collections
import fcntl
import glob
import math
import os
import re
import signal
import socket
import subprocess
import sys
import threading
import time

from PIL import Image, ImageDraw, ImageFont

from tabs3_dashboard_themes import THEMES, ThemeRenderer
from tabs3_dashboard_power import battery_status, charge_behaviour, keeper_target, power_source

try:
    import tabs3_camera          # tabs3-base 0.1.25: the cameras' raw path
except ImportError:
    tabs3_camera = None

CONF = '/etc/tabs3/dashboard.conf'
FB = '/dev/fb0'
FB_SYS = '/sys/class/graphics/fb0'
DPMS = glob.glob('/sys/class/drm/card*-DSI-*/dpms')
WAKE_PIPE = '/run/tabs3-screen/wake'
THEME_STATE = '/var/lib/tabs3-dashboard/theme'
FONTS = os.environ.get('TABS3_FONT_DIR', '/usr/share/fonts')
VT = 7
KDSETMODE, KD_TEXT, KD_GRAPHICS = 0x4B3A, 0, 1
VT_ACTIVATE, VT_WAITACTIVE = 0x5606, 0x5607

DEFAULTS = {
    'REFRESH': 2.0,            # seconds between frames while the screen is on
    'HISTORY_MINUTES': 10,
    'WAKE_ON_LIGHT': 1,
    'LIGHT_CHANGE_PERCENT': 35,  # relative illuminance change that wakes
    'LIGHT_CHANGE_LUX': 3,       # and at least this many lux
    'WAKE_ON_MOTION': 0,         # the tablet lives on a mount; 1 for a desk
    'MOTION_THRESHOLD': 0.25,    # m/s^2 away from the resting magnitude
    'WAKE_ON_SOUND': 1,          # a sound well above the room's floor wakes
    'SOUND_RISE_DB': 15,         # dB above the quietest window of the last 30 s
    'SOUND_MIN_DBFS': -50,       # and at least this loud at the microphone
    'SOUND_DEVICE': 'hw:0,2',    # ALSA capture PCM of the analog microphone
    'WAKE_ON_CAMERA': 1,         # the front camera watches the room while off
    'CAMERA_INTERVAL': 4.0,      # seconds between two frames
    'CAMERA_CHANGE_PERCENT': 3.5,  # change of the coarse picture that wakes
    'WAKE_HOLDOFF': 15,          # seconds between two presence wakes
    'SETTLE_AFTER_OFF': 6,       # seconds to ignore the sensors after screen off
    'PIXEL_SHIFT_SECONDS': 180,  # move the picture a few pixels now and then
    'FONT_SET': 'b612',          # one of FONT_SETS below
    'THEME': 'original',        # original, observatory, folio, terminal or silicon
}

