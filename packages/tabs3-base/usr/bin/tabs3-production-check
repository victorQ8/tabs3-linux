#!/usr/bin/python3
"""Read-only appliance checks and a continuous soak gate (JSON output).

--begin explicitly starts a new qualification interval after a release change.
A passing report covers automated checks only; physical power/recovery tests
and the limitations in docs/production-readiness.md still apply.
"""
import argparse
import datetime
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import subprocess

STATE = Path('/var/lib/tabs3/qualification.json')
UNITS = ('tabs3-dashboard.service', 'tabs3-screen.service', 'ssh.service',
         'tabs3-server-health.timer', 'tabs3-battery-keeper.timer',
         'tabs3-power-guard.timer', 'apt-daily-upgrade.timer')
PACKAGES = ('linux-tabs3', 'tabs3-base', 'tabs3-dashboard', 'tabs3-desktop')
FAULT = re.compile(r'\b(?:BUG:|Oops:|Kernel panic)|\bgpu fault\b|\bring fault\b|'
                   r'preemption timeout|q6asm.*(?:timeout|timed out)|'
                   r'qcom-venus.*(?:SFR message from FW:.*Err_Fatal|'
                   r'system error has occurred|event session error)|'
                   r'(?:remoteproc\d*|qcom[-_]q6v5).*'
                   r'(?:crash detected|crashed|fatal error)|'
                   r'EXT4-fs error|Buffer I/O error|I/O error, dev mmc', re.I)


def run(*args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=15)
    if result.returncode:
        raise RuntimeError(f'{args[0]} exited {result.returncode}: {result.stderr.strip()[:200]}')
    return result.stdout.strip()


def soak(rows, baseline, current, hours):
    if baseline.get('boot_id') != current['boot_id']:
        return dict(passed=False, reason='boot_changed_since_baseline', hours=0)
    start = baseline.get('uptime_s')
    if type(start) not in (int, float) or not 0 <= start <= current['uptime_s']:
        return dict(passed=False, reason='invalid_baseline', hours=0)
    selected = {r['uptime_s']: r for r in rows if r.get('boot_id') == current['boot_id']
                and type(r.get('uptime_s')) in (int, float)
                and start <= r['uptime_s'] <= current['uptime_s']}
    times = sorted(selected)
    points = [start, *times, current['uptime_s']]
    largest_gap = max((b - a for a, b in zip(points, points[1:])), default=0)
    notices = sorted({n for r in selected.values() for n in r.get('notices', [])})
    duration = (current['uptime_s'] - start) / 3600
    return dict(passed=bool(times) and duration >= hours and largest_gap <= 180 and not notices,
                hours=round(duration, 3), required_hours=hours, samples=len(times),
                maximum_gap_s=round(largest_gap, 2), notices=notices)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--begin', action='store_true', help='write a new baseline; does not qualify it')
    parser.add_argument('--hours', type=float, default=72)
    args = parser.parse_args()
    if not 1 <= args.hours <= 144:
        parser.error('--hours must be 1..144 (health retention is seven days)')
    loader = importlib.machinery.SourceFileLoader('health', '/usr/libexec/tabs3-server-health')
    spec = importlib.util.spec_from_loader(loader.name, loader)
    health = importlib.util.module_from_spec(spec)
    loader.exec_module(health)
    current = health.assess(health.collect())
    packages = run('dpkg-query', '-W', '-f=${binary:Package}=${Version}\n', *PACKAGES).splitlines()
    if args.begin:
        os.umask(0o077)
        STATE.parent.mkdir(parents=True, exist_ok=True)
        record = {key: current[key] for key in ('boot_id', 'uptime_s', 'recorded_utc', 'kernel')}
        record['packages'] = packages
        temporary = STATE.with_suffix('.tmp')
        temporary.write_text(json.dumps(record, indent=2) + '\n')
        temporary.replace(STATE)
        print(json.dumps(dict(baseline_started=record, qualified=False), indent=2))
        return
    checks = []

    def add(name, passed, detail):
        checks.append(dict(name=name, passed=bool(passed), detail=detail))

    for unit in UNITS:
        state = run('systemctl', 'show', '-p', 'ActiveState', '--value', unit)
        add(unit, state == 'active', state)
    failed = run('systemctl', '--failed', '--no-legend', '--plain')
    add('failed_units', not failed, failed or 'none')
    audit = run('dpkg', '--audit')
    add('package_database', not audit, audit or 'clean')
    add('root_writable', current['root_read_only'] is False, current['root_read_only'])
    add('offline_root_check', current['root_fsck_status'] in (0, 1), current['root_fsck_status'])
    add('current_health', not current['notices'], current['notices'])
    add('clock_synchronized', current['ntp_synchronized_this_boot'], current['ntp_synchronized_this_boot'])
    auth = dict(line.split(' ', 1) for line in run('/usr/sbin/sshd', '-T').splitlines() if ' ' in line)
    expected = dict(permitrootlogin='no', passwordauthentication='no', kbdinteractiveauthentication='no')
    actual = {key: auth.get(key) for key in expected}
    add('ssh_keys_only', actual == expected, actual)
    guard = json.loads(Path('/run/tabs3-power-guard/latest.json').read_text())
    age = current['uptime_s'] - guard['uptime_s']
    add('power_guard_fresh', guard['boot_id'] == current['boot_id'] and 0 <= age <= 45,
        dict(age_s=round(age, 2), reason=guard['reason']))
    add('power_guard_telemetry', guard['reason'] not in
        ('battery_telemetry_invalid', 'drain_telemetry_unavailable'), guard['reason'])
    try:
        baseline = json.loads(STATE.read_text())
    except (OSError, ValueError):
        baseline = {}
    add('release_unchanged', baseline.get('packages') == packages and
        baseline.get('kernel') == current['kernel'], packages)
    rows, malformed = [], 0
    for path in Path('/var/log/tabs3-server').glob('????-??-??.jsonl'):
        # Recorder bounds daily logs to 8 MiB; do not read an unlimited file.
        if path.stat().st_size > 8 * 1024 * 1024:
            malformed += 1
            continue
        for line in path.read_text().splitlines():
            try:
                row = json.loads(line)
                if not isinstance(row, dict):
                    raise ValueError('not an object')
                rows.append(row)
            except ValueError:
                malformed += 1
    add('health_log_readable', not malformed, dict(malformed_records_or_files=malformed))
    duration = soak(rows, baseline, current, args.hours)
    add('continuous_soak', duration['passed'], duration)
    faults = [line for line in run('dmesg', '--time-format=raw').splitlines() if FAULT.search(line)]
    add('kernel_faults_this_boot', not faults, faults[-20:])
    report = dict(recorded_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
                  automated_gate_passed=all(c['passed'] for c in checks),
                  production_qualified=False,
                  scope='Automated checks only; all hardware data paths, physical power, restart and restore gates remain separate',
                  boot_id=current['boot_id'], checks=checks)
    print(json.dumps(report, indent=2))
    raise SystemExit(0 if report['automated_gate_passed'] else 1)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, KeyError, subprocess.TimeoutExpired) as error:
        print(json.dumps(dict(automated_gate_passed=False, production_qualified=False,
                              collection_error=str(error))))
        raise SystemExit(2)
