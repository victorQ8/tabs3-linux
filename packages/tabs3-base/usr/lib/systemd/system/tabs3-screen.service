[Unit]
Description=Tab S3 LTE screen sleep (power key, touch, idle timeout)
After=systemd-udev-settle.service systemd-udev-trigger.service
ConditionPathExists=/sys/firmware/devicetree/base/compatible

[Service]
Environment=TABS3_SCREEN_IDLE=300
ExecStart=/usr/libexec/tabs3-screen
ExecStopPost=-/bin/sh -c 'echo 0 > /sys/class/graphics/fb0/blank'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
