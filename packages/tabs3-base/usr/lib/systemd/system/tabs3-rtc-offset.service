[Unit]
Description=Tab S3 LTE wall time from the RTC and its saved offset
Documentation=file:/usr/libexec/tabs3-rtc-offset
DefaultDependencies=no
Conflicts=shutdown.target
After=local-fs.target systemd-remount-fs.service
Before=time-set.target sysinit.target shutdown.target
Wants=time-set.target
ConditionPathExists=/sys/class/rtc/rtc0/since_epoch

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tabs3-rtc-offset restore
ExecStop=/usr/libexec/tabs3-rtc-offset save

[Install]
WantedBy=sysinit.target
