#!/bin/sh
# Bind the SX9310 grip sensor once the sensor DSP is up.
#
# The sensor sits on a bit-banged I2C bus (TLMM 81/82). Its probe at boot
# fails with ENXIO (the chip does not answer) a fraction of a second before
# the SLPI finishes booting, and a bind afterwards succeeds; the kernel does
# not retry a probe that failed with ENXIO. Wait for the SLPI to run, then
# bind, retrying for up to a minute.
dev=${1:-3-0028}
driver=/sys/bus/i2c/drivers/sx9310
i=0
while [ $i -lt 60 ]; do
    if [ -e "/sys/bus/i2c/devices/$dev/driver" ]; then
        echo "grip sensor $dev is bound"
        exit 0
    fi
    slpi=$(grep -lx slpi /sys/class/remoteproc/remoteproc*/name 2>/dev/null | head -n 1)
    if [ -n "$slpi" ] && [ "$(cat "${slpi%/name}/state")" = running ] && [ -w "$driver/bind" ]; then
        if echo "$dev" > "$driver/bind" 2>/dev/null; then
            continue
        fi
    fi
    sleep 1
    i=$((i + 1))
done
echo "grip sensor $dev did not bind within 60 s" >&2
exit 1
