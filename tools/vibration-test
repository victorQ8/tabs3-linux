#!/usr/bin/env python3
"""Buzz the vibration motor: two 1.5 s rumble pulses through the force-feedback
interface of the pwm-vibrator input device. Run on the tablet as root.

Usage: sudo python3 vibration-test [PULSES]
"""
import fcntl
import os
import re
import struct
import sys
import time

EVIOCSFF = 0x40304580   # _IOW('E', 0x80, struct ff_effect), 48 bytes
FF_RUMBLE, EV_FF = 0x50, 0x15


def main():
    pulses = int(sys.argv[1]) if len(sys.argv) > 1 else 2
    devices = open('/proc/bus/input/devices').read().split('\n\n')
    try:
        block = next(d for d in devices if 'pwm-vibrator' in d)
    except StopIteration:
        sys.exit('no pwm-vibrator input device')
    event = re.search(r'event\d+', block).group(0)
    fd = os.open('/dev/input/' + event, os.O_RDWR)
    # ff_effect: type, id (-1: let the kernel choose), direction, trigger
    # (button, interval), replay (length ms, delay ms), padding, then the
    # rumble union: strong and weak magnitudes, padded to 32 bytes
    effect = bytearray(struct.pack('<HhHHHHH2x', FF_RUMBLE, -1, 0, 0, 0, 1500, 0)
                       + struct.pack('<HH', 0xffff, 0x8000) + bytes(28))
    fcntl.ioctl(fd, EVIOCSFF, effect)
    effect_id = struct.unpack_from('<h', effect, 2)[0]
    for _ in range(pulses):
        os.write(fd, struct.pack('<qqHHi', 0, 0, EV_FF, effect_id, 1))
        time.sleep(1.5)
        os.write(fd, struct.pack('<qqHHi', 0, 0, EV_FF, effect_id, 0))
        time.sleep(0.7)
    print(f'{pulses} rumble pulses sent on {event} (effect {effect_id}); did it buzz?')


if __name__ == '__main__':
    main()
